# Copy to .env (gitignored) and fill in real values for `docker compose up catportfolio`.

# OpenCat Tunnel backend base URL (no trailing slash).
# Docker: injected into nginx proxy_pass via envsubst at container start — the
# URL is baked into nginx only, never written to config.json or sent to the browser.
# GitHub Pages: set OCT_BASE_URL as a GitHub Actions secret; deploy.yml passes
# it as VITE_OCT_URL to `npm run build` so Vite bakes it into the JS bundle.
OCT_BASE_URL=http://host.docker.internal:10000

# A deny-all-scoped (scopes: []) API key minted via
# core.api_key_management.store.create_api_key — only needs to satisfy the
# /mcp endpoint's auth gate; GATEWAY_ALWAYS_VISIBLE tools (run_graph,
# discover_tools) bypass scope checks regardless of this key's scopes.
#
# Docker deployment: docker-entrypoint.sh templates nginx.conf via envsubst so
# nginx injects "Authorization: Bearer <key>" on /mcp proxying server-side.
# The key is NEVER written to config.json or sent to the browser.
#
# GitHub Pages deployment: set OCT_API_KEY as a GitHub Actions secret
# (Settings → Secrets → Actions). deploy.yml passes it as VITE_OCT_API_KEY to
# `npm run build` so Vite bakes it into the JS bundle at CI time.
OCT_API_KEY=

# Idle timeout (ms) for Andrew's AI chat turns (run_graph). Server keepalives
# reset this window during long LLM/tool phases. Default 600000 (10 minutes).
OCT_ASK_TIMEOUT_MS=600000
