# Copy to .env (gitignored) and fill in real values for `docker compose up catportfolio`.
# Injected into config.json at container start — see docker-entrypoint.sh.

# OpenCat Tunnel backend base URL (no trailing slash)
OCT_BASE_URL=http://localhost:10000

# A deny-all-scoped (scopes: []) API key minted via
# core.api_key_management.store.create_api_key — only needs to satisfy the
# /mcp endpoint's auth gate; GATEWAY_ALWAYS_VISIBLE tools (run_graph,
# discover_tools) bypass scope checks regardless of this key's scopes.
OCT_API_KEY=

# Idle timeout (ms) for Andrew's AI chat turns (run_graph). Server keepalives
# reset this window during long LLM/tool phases. Default 600000 (10 minutes).
OCT_ASK_TIMEOUT_MS=600000
