# Force LF for shell scripts — CRLF breaks shebangs inside Linux containers
*.sh text eol=lf

# Dockerfile and nginx config — keep LF
Dockerfile text eol=lf
nginx.conf text eol=lf
docker-entrypoint.sh text eol=lf

# Vite SSR must strip the scanner's shebang before hoisting imports (CRLF breaks this).
scripts/check-public-safety.mjs text eol=lf

# Everything else: normalize to LF on commit
* text=auto
